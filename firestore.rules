rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && request.auth.token.email == 'codex.martis.dev@gmail.com';
    }

    function isSafeSelfUpdate(userId) {
      return isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.firmId == resource.data.firmId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.permissions == resource.data.permissions &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function hasFirmAccess(firmId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.firmId == firmId;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isOwner());
      allow create: if isOwner();
      allow update: if isOwner() || isSafeSelfUpdate(userId);
      allow delete: if isOwner();
    }

    match /clients/{clientId} {
      allow read: if hasFirmAccess(resource.data.firmId);
      allow create: if hasFirmAccess(request.resource.data.firmId);
      allow update: if hasFirmAccess(resource.data.firmId)
        && request.resource.data.firmId == resource.data.firmId;
      allow delete: if false;
    }

    match /cases/{caseId} {
      allow read: if hasFirmAccess(resource.data.firmId);
      allow create: if hasFirmAccess(request.resource.data.firmId);
      allow update: if hasFirmAccess(resource.data.firmId)
        && request.resource.data.firmId == resource.data.firmId;
      // Casos usam arquivamento/restauração para preservar documentos, agenda e histórico.
      allow delete: if false;
    }

    match /bpcCases/{bpcCaseId} {
      allow read: if hasFirmAccess(resource.data.firmId);
      allow create: if hasFirmAccess(request.resource.data.firmId);
      allow update: if hasFirmAccess(resource.data.firmId)
        && request.resource.data.firmId == resource.data.firmId;
      allow delete: if false;
    }

    match /bpcPendencias/{pendenciaId} {
      allow read: if hasFirmAccess(resource.data.firmId);
      allow create: if hasFirmAccess(request.resource.data.firmId);
      allow update: if hasFirmAccess(resource.data.firmId)
        && request.resource.data.firmId == resource.data.firmId;
      allow delete: if false;
    }

    match /bpcPrazos/{prazoId} {
      allow read: if hasFirmAccess(resource.data.firmId);
      allow create: if hasFirmAccess(request.resource.data.firmId);
      allow update: if hasFirmAccess(resource.data.firmId)
        && request.resource.data.firmId == resource.data.firmId;
      allow delete: if false;
    }

    match /bpcAvaliacoes/{avaliacaoId} {
      allow read: if hasFirmAccess(resource.data.firmId);
      allow create: if hasFirmAccess(request.resource.data.firmId);
      allow update: if hasFirmAccess(resource.data.firmId)
        && request.resource.data.firmId == resource.data.firmId;
      allow delete: if false;
    }

    match /bpcAuditorias/{eventId} {
      allow read: if hasFirmAccess(resource.data.firmId);
      allow create: if hasFirmAccess(request.resource.data.firmId)
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /workflowTemplates/{templateId} {
      allow read: if hasFirmAccess(resource.data.firmId);
      allow create: if hasFirmAccess(request.resource.data.firmId);
      allow update: if hasFirmAccess(resource.data.firmId)
        && request.resource.data.firmId == resource.data.firmId;
      allow delete: if hasFirmAccess(resource.data.firmId);

      match /versions/{versionId} {
        allow read, write: if
          exists(/databases/$(database)/documents/workflowTemplates/$(templateId))
          && hasFirmAccess(
            get(/databases/$(database)/documents/workflowTemplates/$(templateId)).data.firmId
          );
      }
    }

    match /workflowInstances/{instanceId} {
      allow read: if hasFirmAccess(resource.data.firmId);
      allow create: if hasFirmAccess(request.resource.data.firmId);
      allow update: if hasFirmAccess(resource.data.firmId)
        && request.resource.data.firmId == resource.data.firmId;
      allow delete: if hasFirmAccess(resource.data.firmId);

      match /steps/{stepId} {
        allow read: if
          exists(/databases/$(database)/documents/workflowInstances/$(instanceId))
          && hasFirmAccess(
            get(/databases/$(database)/documents/workflowInstances/$(instanceId)).data.firmId
          );
        allow create, update: if
          existsAfter(/databases/$(database)/documents/workflowInstances/$(instanceId))
          && hasFirmAccess(
            getAfter(/databases/$(database)/documents/workflowInstances/$(instanceId)).data.firmId
          );
        allow delete: if
          exists(/databases/$(database)/documents/workflowInstances/$(instanceId))
          && hasFirmAccess(
            get(/databases/$(database)/documents/workflowInstances/$(instanceId)).data.firmId
          );
      }

      match /auditLogs/{eventId} {
        allow read: if
          exists(/databases/$(database)/documents/workflowInstances/$(instanceId))
          && hasFirmAccess(
            get(/databases/$(database)/documents/workflowInstances/$(instanceId)).data.firmId
          );
        allow create: if
          existsAfter(/databases/$(database)/documents/workflowInstances/$(instanceId))
          && hasFirmAccess(
            getAfter(/databases/$(database)/documents/workflowInstances/$(instanceId)).data.firmId
          );
        allow update, delete: if false;
      }
    }

    match /settings/{settingId} {
      allow read: if hasFirmAccess(settingId)
        && resource.data.firmId == settingId;
      allow create: if hasFirmAccess(settingId)
        && request.resource.data.firmId == settingId;
      allow update: if hasFirmAccess(settingId)
        && resource.data.firmId == settingId
        && request.resource.data.firmId == settingId;
      allow delete: if hasFirmAccess(settingId)
        && resource.data.firmId == settingId;
    }

    match /templates/{templateId} {
      allow read: if hasFirmAccess(resource.data.firmId);
      allow create: if hasFirmAccess(request.resource.data.firmId);
      allow update: if hasFirmAccess(resource.data.firmId)
        && request.resource.data.firmId == resource.data.firmId;
      allow delete: if hasFirmAccess(resource.data.firmId);
    }

    match /generatedDocuments/{documentId} {
      allow read: if hasFirmAccess(resource.data.firmId);
      allow create: if hasFirmAccess(request.resource.data.firmId)
        && request.resource.data.clientId is string
        && request.resource.data.templateId is string
        && request.resource.data.status == 'Rascunho'
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if hasFirmAccess(resource.data.firmId)
        && request.resource.data.firmId == resource.data.firmId
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.templateId == resource.data.templateId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid;
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if hasFirmAccess(resource.data.firmId);
      allow create: if hasFirmAccess(request.resource.data.firmId);
      allow update: if hasFirmAccess(resource.data.firmId)
        && request.resource.data.firmId == resource.data.firmId;
      allow delete: if hasFirmAccess(resource.data.firmId);
    }

    match /_connection_test_/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
